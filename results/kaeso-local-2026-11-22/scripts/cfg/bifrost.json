{
  "$schema": "https://www.getbifrost.ai/schema",
  "client": { "enable_logging": false, "enforce_auth_on_inference": false },
  "config_store": { "enabled": false },
  "logs_store": { "enabled": false },
  "providers": {
    "mock": {
      "keys": [{ "name": "mock-key", "value": "dummy", "models": ["*"], "weight": 1.0 }],
